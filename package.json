{
  "name": "small-cap-stock-screener",
  "version": "0.1.0",
  "private": true,
  "description": "Daily pre-market shortlist of small-cap momentum candidates, screened on five published momentum criteria.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "ingest": "node --experimental-strip-types scripts/ingest.ts",
    "build": "node --experimental-strip-types scripts/build-page.ts",
    "build:site": "npm run ingest && npm run build",
    "backtest": "node --experimental-strip-types scripts/backtest.ts",
    "paper": "node --experimental-strip-types scripts/paper.ts",
    "serve": "python3 -m http.server 4188 --directory _site",
    "backtest:intraday": "node --experimental-strip-types scripts/backtest-intraday.ts",
    "fetch:universe": "node --experimental-strip-types scripts/fetch-db-universe.ts",
    "fetch:minutes": "node --experimental-strip-types scripts/fetch-db-minutes.ts",
    "premarket": "node --experimental-strip-types scripts/premarket.ts",
    "build:premarket": "node --experimental-strip-types scripts/build-premarket.ts",
    "build:research": "node --experimental-strip-types scripts/build-page.ts",
    "site": "npm run premarket && npm run build:premarket",
    "avgvol": "node --experimental-strip-types scripts/make-avgvol.ts",
    "snapshot": "node --experimental-strip-types scripts/snapshot-closes.ts",
    "demo": "node --experimental-strip-types scripts/make-demo.ts && node --experimental-strip-types scripts/build-demo.ts",
    "build:demo": "node --experimental-strip-types scripts/build-demo.ts",
    "notify": "node --experimental-strip-types scripts/notify.ts",
    "history:fill": "node --experimental-strip-types scripts/fill-history.ts",
    "strategies": "node --experimental-strip-types scripts/session-strategies.ts",
    "early": "node --experimental-strip-types scripts/early-flags.ts",
    "playbook": "node --experimental-strip-types scripts/playbook.ts",
    "high-timing": "node --experimental-strip-types scripts/high-timing.ts",
    "strict": "node --experimental-strip-types scripts/strict-shortlist.ts",
    "target-sweep": "node --experimental-strip-types scripts/target-sweep.ts",
    "options-pilot": "node --experimental-strip-types scripts/options-pilot.ts"
  }
}
